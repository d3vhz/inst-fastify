{
  "name": "inst-fastify",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env ./src/server.ts",
    "supabase:up": "npx supabase start",
    "supabase:down": "npx supabase stop",
    "prisma:generate": "npx prisma generate",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "build": "tsdown",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --max-warnings=0",
      "oxfmt"
    ],
    "ignore": [
      "**/prisma/generated/**/*.ts"
    ]
  },
  "dependencies": {
    "@fastify/autoload": "^6.4.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.0",
    "@supabase/supabase-js": "^2.110.2",
    "amqplib": "^2.0.1",
    "close-with-grace": "^2.5.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "supabase": "^2.109.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "fastify-tsconfig": "^3.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
