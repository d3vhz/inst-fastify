generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

enum UserRole {
  user
  admin

  @@map("user_role")
  @@schema("public")
}

enum Status {
  active
  archived

  @@map("post_status")
  @@schema("public")
}

model AuthUser {
  instanceId                  String?                @map("instance_id") @db.Uuid
  id                          String                 @id @db.Uuid
  aud                         String?                @db.VarChar(255)
  role                        String?                @db.VarChar(255)
  email                       String?                @unique(map: "users_email_partial_key", where: raw("(is_sso_user = false)")) @db.VarChar(255)
  user                        User?

  @@index([instanceId])
  @@map("users")
  @@schema("auth")
}

model User {
  id          String      @id @db.Uuid
  firstName   String?     @map("first_name") @db.VarChar(15)
  lastName    String?     @map("last_name") @db.VarChar(15)
  avatarUrl   String?     @map("avatar_url")
  roles       UserRole[]  @default([user])
  createdAt   DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  postLikes   PostLike[]
  postSaves   PostSave[]
  posts       Post[]
  user        AuthUser    @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("users")
  @@schema("public")
}

model Post {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  imgUrls     String[]    @default([]) @map("img_urls")
  caption     String      @db.VarChar(500)
  status      Status
  likes       Int         @default(0)
  createdAt   DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  postLikes   PostLike[]
  postSaves   PostSave[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("posts")
  @@schema("public")
}

model PostSave {
  postId      String     @map("post_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  createdAt   DateTime   @map("created_at") @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([postId, userId])
  @@map("post_saves")
  @@schema("public")
}

model PostLike {
  postId      String   @map("post_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @map("created_at") @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([postId, userId])
  @@map("post_likes")
  @@schema("public")
}
